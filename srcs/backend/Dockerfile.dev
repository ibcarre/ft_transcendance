FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y curl \
		&& rm -rf /var/apt/list/*

WORKDIR /app

COPY ./package.json .
COPY ./package-lock.json .
COPY ./scripts/secrets.sh ./scripts/secrets.sh

RUN chmod +x ./scripts/secrets.sh

RUN npm ci

ENTRYPOINT ["/bin/sh", "./scripts/secrets.sh", "dev"]
