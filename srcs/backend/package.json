{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
	"test": "npm run game:verify",
	"prebuild": "npm run game:build",
	"build": "node ./src/index.js",
	"predev": "npm run game:build",
	"dev": "node --watch ./src/index.js",
	"game:check": "tsc -p tsconfig.game.json",
	"game:build": "tsc -p tsconfig.game.build.json",
	"game:watch": "tsc -p tsconfig.game.build.json --watch",
	"game:smoke": "npm run game:build && node --test ./scripts/game-runtime.test.cjs",
	"game:test": "./scripts/game-engine-tests.sh",
	"game:test:watch": "tsx --test --watch game/test/*.test.ts src/game/test/*.test.ts",
	"game:verify": "npm run game:check && npm run game:test && npm run game:smoke"
  },
