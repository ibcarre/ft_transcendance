    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.3.0",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "fs": "^0.0.1-security",
    "image-type": "^6.1.0",
    "jsonwebtoken": "^9.0.3",
    "leo-profanity": "^1.9.0",
