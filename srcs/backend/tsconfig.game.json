{
    "compilerOptions": {
        "target": "ES2022",

        "module": "CommonJS",
        // "moduleResolution": "Node",

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,

        "types": ["node"],

        "noEmit": true
    },

    "include": [
        "game/**/*.ts"
    ]
}
